---
const year = new Date().getFullYear();

const footerLinks = {
  product: {
    title: 'Продукт',
    links: [
      { label: 'Можливості', href: '#features' },
      { label: 'Демо', href: '#demo' },
      { label: 'Ціни', href: '#pricing' },
    ],
  },
  company: {
    title: 'Компанія',
    links: [
      { label: 'Про нас', href: '#' },
      { label: 'Блог', href: '#' },
      { label: 'Контакти', href: '#' },
    ],
  },
  legal: {
    title: 'Юридичне',
    links: [
      { label: 'Політика конфіденційності', href: '#' },
      { label: 'Умови використання', href: '#' },
    ],
  },
};
---

<footer class="bg-foreground text-background py-16 lg:py-20">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-5 gap-12 lg:gap-8">
      <!-- Brand Column -->
      <div class="lg:col-span-2">
        <a href="#" class="flex items-center gap-2.5 mb-6">
          <div class="w-9 h-9 rounded-lg bg-primary flex items-center justify-center">
            <svg class="w-5 h-5 text-primary-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>
            </svg>
          </div>
          <span class="font-inter font-semibold text-lg text-background">
            TTN<span class="text-primary">Flow</span>
          </span>
        </a>
        <p class="text-background/60 mb-6 max-w-sm leading-relaxed">
          Автоматизуйте обробку відправлень Нової Пошти. Заощаджуйте час, зменшуйте помилки та зосередьтесь на розвитку бізнесу.
        </p>
      </div>

      <!-- Links Columns -->
      {Object.values(footerLinks).map((section) => (
        <div>
          <h4 class="font-semibold text-background mb-4">{section.title}</h4>
          <ul class="space-y-3">
            {section.links.map((link) => (
              <li>
                <a href={link.href} class="text-sm text-background/60 hover:text-background transition-colors">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-background/10 mt-12 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-sm text-background/40">
        © {year} TTNFlow. Всі права захищені.
      </p>
    </div>
  </div>
</footer>
