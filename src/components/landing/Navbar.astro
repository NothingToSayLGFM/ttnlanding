---
const navLinks = [
  { label: 'Features', href: '#features' },
  { label: 'Demo', href: '#demo' },
  { label: 'Pricing', href: '#pricing' },
];
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <a href="#" class="flex items-center gap-2.5">
        <div class="w-9 h-9 rounded-lg bg-primary flex items-center justify-center">
          <svg class="w-5 h-5 text-primary-foreground" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m7.5 4.27 9 5.15"/><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>
          </svg>
        </div>
        <span class="font-inter font-semibold text-lg text-foreground">
          TTN<span class="text-primary">Flow</span>
        </span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>

      <!-- Desktop CTA -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="/app/login"
          class="inline-flex items-center justify-center h-9 px-4 text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-secondary rounded-md transition-colors"
        >
          Sign In
        </a>
        <a
          href="/app/register"
          class="inline-flex items-center justify-center h-9 px-4 text-sm font-medium bg-primary hover:bg-primary/90 text-primary-foreground rounded-md transition-colors"
        >
          Request Access
        </a>
      </div>

      <!-- Mobile Menu Toggle -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2 text-foreground"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="icon-menu" class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
        <svg id="icon-x" class="w-5 h-5 hidden" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="md:hidden bg-background border-b border-border overflow-hidden max-h-0 transition-all duration-300 ease-in-out"
  >
    <div class="px-6 py-4 space-y-4">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-link block text-sm font-medium text-muted-foreground hover:text-foreground transition-colors"
        >
          {link.label}
        </a>
      ))}
      <div class="pt-4 border-t border-border space-y-2">
        <a
          href="/app/login"
          class="flex items-center justify-start w-full h-10 px-4 text-sm font-medium text-muted-foreground hover:text-foreground hover:bg-secondary rounded-md transition-colors"
        >
          Sign In
        </a>
        <a
          href="/app/register"
          class="flex items-center justify-center w-full h-10 px-4 text-sm font-medium bg-primary hover:bg-primary/90 text-primary-foreground rounded-md transition-colors"
        >
          Request Access
        </a>
      </div>
    </div>
  </div>
</nav>

<script>
  const navbar = document.getElementById('navbar');
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconX = document.getElementById('icon-x');

  // Scroll effect
  window.addEventListener('scroll', () => {
    if (window.scrollY > 20) {
      navbar.classList.add('bg-background/80', 'backdrop-blur-xl', 'border-b', 'border-border');
    } else {
      navbar.classList.remove('bg-background/80', 'backdrop-blur-xl', 'border-b', 'border-border');
    }
  }, { passive: true });

  // Mobile menu toggle
  let isOpen = false;
  mobileMenuBtn.addEventListener('click', () => {
    isOpen = !isOpen;
    mobileMenu.style.maxHeight = isOpen ? mobileMenu.scrollHeight + 'px' : '0';
    iconMenu.classList.toggle('hidden', isOpen);
    iconX.classList.toggle('hidden', !isOpen);
    mobileMenuBtn.setAttribute('aria-expanded', String(isOpen));
  });

  // Close mobile menu on nav link click
  document.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', () => {
      isOpen = false;
      mobileMenu.style.maxHeight = '0';
      iconMenu.classList.remove('hidden');
      iconX.classList.add('hidden');
      mobileMenuBtn.setAttribute('aria-expanded', 'false');
    });
  });
</script>
