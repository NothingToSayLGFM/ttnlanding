---
const problems = [
  {
    icon: 'clock',
    title: 'Години ручної роботи',
    description: 'Копіювання номерів одне за одним у Нову Пошту займає вічність.',
  },
  {
    icon: 'repeat',
    title: 'Дублікати записів',
    description: 'Без автоматичного виявлення дублікати просочуються і спричиняють помилки.',
  },
  {
    icon: 'alert-triangle',
    title: 'Людські помилки',
    description: 'Неправильні ТТН, неправильні реєстри — помилки коштують часу і грошей.',
  },
  {
    icon: 'file-x',
    title: 'Розкидані дані',
    description: 'Номери розкидані по файлах, чатах та листах.',
  },
];
---

<section class="py-24 lg:py-32 relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">

      <!-- Image -->
      <div data-animate-x class="relative order-2 lg:order-1">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl">
          <img
            src="/images/problem-placeholder.svg"
            alt="Хаотичні накладні що представляють ручну роботу"
            class="w-full aspect-[4/3] object-cover"
            width="800"
            height="600"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-foreground/20 to-transparent"></div>
        </div>

        <!-- Floating Badge -->
        <div class="absolute -bottom-4 -right-4 lg:-right-8 bg-destructive text-destructive-foreground px-4 py-2 rounded-lg shadow-lg">
          <p class="text-sm font-semibold">~3 години/день витрачено</p>
        </div>
      </div>

      <!-- Content -->
      <div class="order-1 lg:order-2 space-y-8">
        <div data-animate>
          <span class="inline-block text-xs font-medium uppercase tracking-widest text-destructive mb-4">
            Проблема
          </span>
          <h2 class="text-3xl lg:text-4xl font-bold text-foreground leading-tight mb-4">
            Ручна обробка відправлень{' '}
            <span class="text-destructive">вбиває вашу продуктивність</span>
          </h2>
          <p class="text-lg text-muted-foreground">
            Щодня логістичні команди витрачають години на рутинні завдання, які можна автоматизувати.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 gap-6">
          {problems.map((problem, index) => (
            <div
              data-animate
              class="flex gap-4"
              style={`transition-delay: ${index * 100}ms`}
            >
              <div class="w-10 h-10 rounded-lg bg-destructive/10 flex items-center justify-center flex-shrink-0">
                {problem.icon === 'clock' && (
                  <svg class="w-5 h-5 text-destructive" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                )}
                {problem.icon === 'repeat' && (
                  <svg class="w-5 h-5 text-destructive" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m17 2 4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
                )}
                {problem.icon === 'alert-triangle' && (
                  <svg class="w-5 h-5 text-destructive" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/></svg>
                )}
                {problem.icon === 'file-x' && (
                  <svg class="w-5 h-5 text-destructive" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"/><path d="M14 2v4a2 2 0 0 0 2 2h4"/><path d="m10 12.5 4 4"/><path d="m14 12.5-4 4"/></svg>
                )}
              </div>
              <div>
                <h3 class="font-semibold text-foreground mb-1">{problem.title}</h3>
                <p class="text-sm text-muted-foreground">{problem.description}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>
