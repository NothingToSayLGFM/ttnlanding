---
const plans = [
  {
    name: 'Стартовий',
    description: 'Для малого інтернет-бізнесу',
    price: '₴499',
    period: '/міс',
    capacity: { label: 'ТТН на місяць', value: 5000, max: 50000 },
    features: [
      'Завантаження файлів (TXT/CSV)',
      'Виявлення дублікатів',
      'Розподіл по реєстрах',
      'Email підтримка',
    ],
    cta: 'Спробувати безкоштовно',
    highlighted: false,
  },
  {
    name: 'Професійний',
    description: 'Для бізнесу, що росте',
    price: '₴1 499',
    period: '/міс',
    capacity: { label: 'ТТН на місяць', value: 25000, max: 50000 },
    features: [
      'Все зі Стартового',
      'Інтеграція з API Нової Пошти',
      'Авто-синхронізація реєстрів',
      'Пріоритетна підтримка',
      'Гнучкий механізм правил',
    ],
    cta: 'Спробувати безкоштовно',
    highlighted: true,
  },
  {
    name: 'Корпоративний',
    description: 'Для великих операцій',
    price: 'Індивідуально',
    period: '',
    capacity: { label: 'ТТН на місяць', value: 50000, max: 50000 },
    features: [
      'Все з Професійного',
      'Необмежені ТТН',
      'Персональний менеджер',
      'Індивідуальні інтеграції',
      'Гарантія SLA',
      'Хостинг на вашому сервері',
    ],
    cta: 'Зв\'язатись з нами',
    highlighted: false,
  },
];
---

<section id="pricing" class="py-24 lg:py-32 bg-secondary/30 relative">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <!-- Header -->
    <div data-animate class="text-center max-w-3xl mx-auto mb-16 lg:mb-20">
      <span class="inline-block text-xs font-medium uppercase tracking-widest text-primary mb-4">Ціни</span>
      <h2 class="text-3xl lg:text-4xl font-bold text-foreground leading-tight mb-4">
        Прозорі ціни без сюрпризів
      </h2>
      <p class="text-lg text-muted-foreground">
        Оберіть план відповідно до вашого обсягу. Всі плани включають 14-денний безкоштовний тріал.
      </p>
    </div>

    <!-- Pricing Cards -->
    <div class="grid lg:grid-cols-3 gap-6 lg:gap-8 max-w-6xl mx-auto">
      {plans.map((plan, index) => (
        <div
          data-animate
          class={`relative bg-card rounded-3xl p-8 ${
            plan.highlighted
              ? 'border-2 border-primary shadow-xl animate-pulse-glow'
              : 'border border-border shadow-sm'
          }`}
          style={`transition-delay: ${index * 100}ms`}
        >
          <!-- Plan Header -->
          <div class="mb-8">
            <h3 class="text-xl font-semibold text-foreground mb-2">{plan.name}</h3>
            <p class="text-sm text-muted-foreground">{plan.description}</p>
          </div>

          <!-- Price -->
          <div class="mb-8">
            <div class="flex items-baseline gap-1">
              <span class="font-mono text-4xl lg:text-5xl font-bold text-foreground">{plan.price}</span>
              {plan.period && <span class="text-muted-foreground">{plan.period}</span>}
            </div>
          </div>

          <!-- Capacity Bar -->
          <div class="mb-8">
            <div class="flex justify-between text-sm mb-2">
              <span class="text-muted-foreground">{plan.capacity.label}</span>
              <span class="font-mono font-medium text-foreground">
                {plan.capacity.value === plan.capacity.max && plan.name === 'Корпоративний'
                  ? 'Необмежено'
                  : plan.capacity.value.toLocaleString('uk-UA')}
              </span>
            </div>
            <div class="h-2 bg-secondary rounded-full overflow-hidden">
              <div
                class={`h-full rounded-full ${plan.highlighted ? 'bg-primary' : 'bg-muted-foreground/30'}`}
                style={`width: ${(plan.capacity.value / plan.capacity.max) * 100}%`}
              ></div>
            </div>
          </div>

          <!-- Features -->
          <ul class="space-y-3 mb-8">
            {plan.features.map((feature) => (
              <li class="flex items-start gap-3">
                <svg
                  class={`w-5 h-5 flex-shrink-0 mt-0.5 ${plan.highlighted ? 'text-primary' : 'text-accent'}`}
                  xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                ><path d="M20 6 9 17l-5-5"/></svg>
                <span class="text-sm text-foreground">{feature}</span>
              </li>
            ))}
          </ul>

          <!-- CTA -->
          <a
            href="/app"
            class={`flex items-center justify-center w-full h-12 rounded-lg font-medium transition-colors gap-2 ${
              plan.highlighted
                ? 'bg-primary hover:bg-primary/90 text-primary-foreground'
                : 'bg-secondary hover:bg-secondary/80 text-foreground'
            }`}
          >
            {plan.cta}
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
        </div>
      ))}
    </div>

    <p data-animate class="text-center text-sm text-muted-foreground mt-12">
      14 днів безкоштовно • Без кредитної картки • Скасування будь-коли
    </p>
  </div>
</section>
