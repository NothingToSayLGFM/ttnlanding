---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/landing/Navbar.astro';
import HeroSection from '../components/landing/HeroSection.astro';
import ProblemSection from '../components/landing/ProblemSection.astro';
import SolutionSection from '../components/landing/SolutionSection.astro';
import FeaturesGrid from '../components/landing/FeaturesGrid.astro';
import DemoPreview from '../components/islands/DemoPreview.vue';
import BenefitsSection from '../components/landing/BenefitsSection.astro';
import CalculatorSection from '../components/landing/CalculatorSection.astro';
import CTASection from '../components/landing/CTASection.astro';
import Footer from '../components/landing/Footer.astro';
---

<BaseLayout
  title="TTNFlow — Автоматизація Нової Пошти"
  description="Автоматизуй обробку відправлень Нової Пошти. Знаходь дублікати, розподіляй у реєстри та синхронізуй з API Нової Пошти."
>
  <Navbar />
  <main>
    <HeroSection />
    <ProblemSection />
    <SolutionSection />
    <FeaturesGrid />
    <DemoPreview client:visible />
    <BenefitsSection />
    <CalculatorSection />
    <CTASection />
  </main>
  <Footer />
</BaseLayout>
